OPENAI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Gemini models to try in order (comma-separated). Google tracks free-tier
# quota separately per model, so this list is extra free daily capacity, not
# just an outage fallback. Default tries the newest/best model first, then
# falls back to established models once it's exhausted.
GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.5-flash-lite

# OpenRouter model. Defaults to a free (":free" suffix) model so no credits
# are spent — see https://openrouter.ai/models?variant=free for the current
# list. Free models are capped by OpenRouter at 20 req/min and 50/day (or
# 1000/day after a one-time $10 lifetime credit purchase). Other solid
# general-purpose free options as of writing: minimax/minimax-m3:free,
# google/gemma-4-31b-it:free.
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Comma-separated list of extra origins allowed to call this API
# (https://abolnikovanton.github.io and any localhost port are always allowed).
ALLOWED_ORIGINS=

# Rate limit for POST /chat, per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Caps on generated reply length per provider.
GEMINI_MAX_TOKENS=1024
OPENROUTER_MAX_TOKENS=1024
