OPENAI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
PORT=3000

# Fallback order is: Gemini (each model in GEMINI_MODELS) -> Groq -> Cerebras
# -> OpenRouter. Groq and Cerebras are separate free-tier services (not
# "free variant of a paid API"), so they're extra independent quota pools —
# redundancy for when Gemini and OpenRouter are both rate-limited at once
# (e.g. a burst of users), not just an outage fallback. Any provider whose
# API key is left blank is skipped entirely.

# Gemini models to try in order (comma-separated). Google tracks free-tier
# quota separately per model, so this list is extra free daily capacity, not
# just an outage fallback. Default tries the newest/best model first, then
# falls back to established models once it's exhausted.
GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.5-flash-lite

# Groq: get a free API key at https://console.groq.com/keys (no credit card).
# Free tier is roughly 30 req/min; requests/day varies by model (see
# https://console.groq.com/docs/rate-limits). llama-3.3-70b-versatile is a
# solid general-purpose default; llama-3.1-8b-instant has a much higher
# daily cap if you hit limits often.
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras: get a free API key at https://cloud.cerebras.ai (no credit card).
# See https://inference-docs.cerebras.ai/models/overview for current models.
CEREBRAS_MODEL=gpt-oss-120b

# OpenRouter model. Defaults to a free (":free" suffix) model so no credits
# are spent — see https://openrouter.ai/models?variant=free for the current
# list. Free models are capped by OpenRouter at 20 req/min and 50/day (or
# 1000/day after a one-time $10 lifetime credit purchase). Other solid
# general-purpose free options as of writing: minimax/minimax-m3:free,
# google/gemma-4-31b-it:free.
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Comma-separated list of extra origins allowed to call this API
# (https://abolnikovanton.github.io and any localhost port are always allowed).
ALLOWED_ORIGINS=

# Rate limit for POST /chat, per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Caps on generated reply length per provider. Too low and detailed answers
# (multi-section lists, code) get cut off mid-sentence with no error — the
# model just stops because it hit the cap, not because anything failed.
GEMINI_MAX_TOKENS=2048
GROQ_MAX_TOKENS=2048
CEREBRAS_MAX_TOKENS=2048
OPENROUTER_MAX_TOKENS=2048
